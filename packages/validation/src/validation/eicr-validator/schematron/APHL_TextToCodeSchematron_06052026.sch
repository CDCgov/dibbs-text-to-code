      <xsl:apply-templates mode="M92"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M92"/>
   <xsl:template match="//cda:observation[cda:templateId[@root = '2.16.840.1.113883.10.20.22.4.2']]"
      priority="3999"
      mode="M11">
      <xsl:choose>
         <xsl:when test="                 not(cda:code) or                 cda:code[@nullFlavor] or                 cda:code/@code or                 cda:code/cda:translation/@code"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">text_to_code</xsl:attribute>
                  <xsl:element name="assertionID">ttc-labTestNameResulted-code-missing</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Text to Code: Lab Test Name Resulted does not have a @code attribute.</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">                 not(cda:code) or                 cda:code[@nullFlavor] or                 cda:code/@code or                 cda:code/cda:translation/@code</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="                 not(cda:code) or                  cda:code[@nullFlavor] or                  count(cda:code[@code = '']) = 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">text_to_code</xsl:attribute>
                  <xsl:element name="assertionID">ttc-labTestNameResulted-code-empty</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Text to Code: Result observation code data element @code attribute is blank.</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">                 not(cda:code) or                  cda:code[@nullFlavor] or                  count(cda:code[@code = '']) = 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="                 not(cda:code) or                  cda:code[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">text_to_code</xsl:attribute>
                  <xsl:element name="assertionID">ttc-labTestNameResulted-code-nullFlavor</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Text to Code: Result observation code data element is nullFlavor.</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">                 not(cda:code) or                  cda:code[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="                 not(cda:code/@code or cda:code/cda:translation/@code) or                   cda:code[@codeSystem = '2.16.840.1.113883.6.1'] or                 cda:code/cda:translation[@codeSystem = '2.16.840.1.113883.6.1']"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">text_to_code</xsl:attribute>
                  <xsl:element name="assertionID">ttc-labTestNameResulted-wrongCode</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Text to Code: Lab Test Name Resulted code and translation data elements @codeSystem attribute are not LOINC 2.16.840.1.113883.6.1</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">                 not(cda:code/@code or cda:code/cda:translation/@code) or                   cda:code[@codeSystem = '2.16.840.1.113883.6.1'] or                 cda:code/cda:translation[@codeSystem = '2.16.840.1.113883.6.1']</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M11"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M11"/>
   <xsl:template match="//cda:section[cda:templateId/@root = '2.16.840.1.113883.10.20.22.2.10']/cda:entry/cda:observation[cda:templateId/@root = '2.16.840.1.113883.10.20.22.4.44']"
      priority="3999"
      mode="M12">
      <xsl:choose>
         <xsl:when test="                 not(cda:code) or                  cda:code[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">text_to_code</xsl:attribute>
                  <xsl:element name="assertionID">ttc-labOrder-code-nullFlavor</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Text to Code: Planned observation code data element is nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">                 not(cda:code) or                  cda:code[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="                 not(cda:code) or                  cda:code[@nullFlavor] or                  count(cda:code[@code]) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">text_to_code</xsl:attribute>
                  <xsl:element name="assertionID">ttc-labOrder-code-missing</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Text to Code: Planned observation code data element has no @code attribute</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">                 not(cda:code) or                  cda:code[@nullFlavor] or                  count(cda:code[@code]) = 1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="                 not(cda:code) or                  cda:code[@nullFlavor] or                  count(cda:code[@code = '']) = 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">text_to_code</xsl:attribute>
                  <xsl:element name="assertionID">ttc-labOrder-code-empty</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Text to Code: Planned observation code data element @code attribute is blank</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">                 not(cda:code) or                  cda:code[@nullFlavor] or                  count(cda:code[@code = '']) = 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="                 not(cda:code/@code or cda:code/cda:translation/@code) or                   cda:code[@codeSystem = '2.16.840.1.113883.6.1'] or                 cda:code[@codeSystem = '2.16.840.1.113883.6.96'] or                  cda:code[@codeSystem = '2.16.840.1.113883.6.12'] or                  cda:code[@codeSystem = '2.16.840.1.113883.6.4'] or                  cda:code[@codeSystem = '2.16.840.1.113883.6.13'] or                 cda:code/cda:translation[@codeSystem = '2.16.840.1.113883.6.1'] or                 cda:code/cda:translation[@codeSystem = '2.16.840.1.113883.6.96'] or                  cda:code/cda:translation[@codeSystem = '2.16.840.1.113883.6.12'] or                  cda:code/cda:translation[@codeSystem = '2.16.840.1.113883.6.4'] or                  cda:code/cda:translation[@codeSystem = '2.16.840.1.113883.6.13']"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">text_to_code</xsl:attribute>
                  <xsl:element name="assertionID">ttc-labOrder-wrongCode</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Text to Code: Lab Test Name Resulted code and translation data elements @codeSystem attribute are not LOINC (2.16.840.1.113883.6.1), SNOMED CT (2.16.840.1.113883.6.96), CPT-4 (2.16.840.1.113883.6.12), ICD10 PCS (2.16.840.1.113883.6.4) or CDT-2 (2.16.840.1.113883.6.13)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">                 not(cda:code/@code or cda:code/cda:translation/@code) or                   cda:code[@codeSystem = '2.16.840.1.113883.6.1'] or                 cda:code[@codeSystem = '2.16.840.1.113883.6.96'] or                  cda:code[@codeSystem = '2.16.840.1.113883.6.12'] or                  cda:code[@codeSystem = '2.16.840.1.113883.6.4'] or                  cda:code[@codeSystem = '2.16.840.1.113883.6.13'] or                 cda:code/cda:translation[@codeSystem = '2.16.840.1.113883.6.1'] or                 cda:code/cda:translation[@codeSystem = '2.16.840.1.113883.6.96'] or                  cda:code/cda:translation[@codeSystem = '2.16.840.1.113883.6.12'] or                  cda:code/cda:translation[@codeSystem = '2.16.840.1.113883.6.4'] or                  cda:code/cda:translation[@codeSystem = '2.16.840.1.113883.6.13']</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M12"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M12"/>
   <xsl:template match="text()" priority="-1"/>
</xsl:stylesheet>
