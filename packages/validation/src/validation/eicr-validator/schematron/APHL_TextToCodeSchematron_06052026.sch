      <xsl:choose>
         <xsl:when test="@classCode = 'ENC'"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-8710</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] @classCode="ENC"
                     (CodeSystem: HL7ActClass urn:oid:2.16.840.1.113883.5.6 STATIC)
                     (CONF:1198-8710).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
