                  <xsl:element name="message">Data Quality: Planned medication time data element
                     @value attribute is not in valid CDA TS format
                     (YYYY[MM[DD[HH[MM[SS[.s+]]]]]][±HHMM]).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:effectiveTime) or cda:effectiveTime[@nullFlavor]
                     or (not(cda:effectiveTime[@value]) and not(cda:effectiveTime/cda:low[@value]))
                     or matches(normalize-space(cda:effectiveTime/@value),
                     '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$') or
                     matches(normalize-space(cda:effectiveTime/cda:low/@value),
                     '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$')</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="not(cda:routeCode) or cda:routeCode[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-planned-medication-routecode-001</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned Medication Route data element is
                     nullFlavor.</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:routeCode) or
                     cda:routeCode[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:routeCode) or cda:routeCode[@nullFlavor] or not(cda:routeCode/@code) or cda:routeCode/@code = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = '2.16.840.1.113883.3.88.12.3221.8.7']/voc:code/@value"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-planned-medication-routecode-002</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned Medication Route data element is
                     not in the valueset SPL Drug Route of Administration Terminology</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:routeCode) or cda:routeCode[@nullFlavor] or
                     not(cda:routeCode/@code) or cda:routeCode/@code =
                     document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid
                     = '2.16.840.1.113883.3.88.12.3221.8.7']/voc:code/@value</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="cda:doseQuantity"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID"
                     >dq-planned-medication-doseQuantity-001</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned Medication Dose Quantity data
                     element is not present.</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">cda:doseQuantity</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="not(cda:doseQuantity) or cda:doseQuantity[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID"
                     >dq-planned-medication-doseQuantity-002</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned Medication Dose Quantity data
                     element is nullFlavor.</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(cda:doseQuantity) or
                     cda:doseQuantity[not(@nullFlavor)] </xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:doseQuantity) or cda:doseQuantity[@nullFlavor] or count(cda:doseQuantity[@value = '']) = 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID"
                     >dq-planned-medication-doseQuantity-003</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned Medication Dose Quantity data
                     element is blank.</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(cda:doseQuantity) or cda:doseQuantity[@nullFlavor] or
                     count(cda:doseQuantity[@value='']) = 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(cda:doseQuantity) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID"
                     >dq-planned-medication-doseQuantity-004</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned Medication SHALL contain exactly
                     one [1..1] doseQuantity.</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:doseQuantity)=1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="not(cda:rateQuantity) or cda:rateQuantity[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID"
                     >dq-planned-medication-rateQuantity-001</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned Medication Rate Quantity data
                     element is nullFlavor.</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(cda:rateQuantity) or
                     cda:rateQuantity[not(@nullFlavor)] </xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:rateQuantity) or cda:rateQuantity[@nullFlavor] or cda:rateQuantity/@unit = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = '2.16.840.1.113883.1.11.12839']/voc:code/@value"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID"
                     >dq-planned-medication-rateQuantity-002</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned Medication Rate Quantity data
                     element is not in valueset UnitsOfMeasureCaseSensitive</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(cda:rateQuantity) or cda:rateQuantity[@nullFlavor] or
                     cda:rateQuantity/@unit =
                     document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid
                     = '2.16.840.1.113883.1.11.12839']/voc:code/@value</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M54"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M54"/>
   <xsl:template
      match="//cda:entryRelationship[@typeCode = 'SUBJ']/cda:observation[cda:templateId[@root = '2.16.840.1.113883.10.20.22.4.4']]"
      priority="3999" mode="M55">
      <xsl:choose>
         <xsl:when test="cda:value[not(@nullFlavor)] or cda:value/cda:translation[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-problemObservation-001</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
