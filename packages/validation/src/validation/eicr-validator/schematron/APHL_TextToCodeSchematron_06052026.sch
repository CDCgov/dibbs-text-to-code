   <xsl:template match="text()" priority="-1" mode="M296"/>
   <xsl:template
      match="//cda:component/cda:observation[cda:templateId[@root = '2.16.840.1.113883.10.20.22.4.2']]"
      priority="3999" mode="M13">
      <xsl:choose>
         <xsl:when test="not(cda:id) or cda:id[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-resultObservation-id-001</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Result observation id data element is
                     nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:id) or cda:id[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="not(cda:id) or cda:id[@nullFlavor] or count(cda:id/@root) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-resultObservation-id-002</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Result observation id data element has
                     no @root attribute</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:id) or cda:id[@nullFlavor] or
                     count(cda:id/@root) = 1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="not(cda:id) or cda:id[@nullFlavor] or count(cda:id[@root = '']) = 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-resultObservation-id-003</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Result observation id data element @root
                     attribute is blank</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:id) or cda:id[@nullFlavor] or count(cda:id[@root
                     = '']) = 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="not(cda:code) or cda:code[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-resultObservation-code-007</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Result observation code data element is
                     nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:code) or
                     cda:code[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="not(cda:code) or cda:code[@nullFlavor] or count(cda:code[@code]) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-resultObservation-code-001</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Result observation code data element has
                     no @code attribute</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:code) or cda:code[@nullFlavor] or
                     count(cda:code[@code]) = 1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="not(cda:code) or cda:code[@nullFlavor] or count(cda:code[@code = '']) = 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-resultObservation-code-002</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Result observation code data element
                     @code attribute is blank</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:code) or cda:code[@nullFlavor] or
                     count(cda:code[@code = '']) = 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
