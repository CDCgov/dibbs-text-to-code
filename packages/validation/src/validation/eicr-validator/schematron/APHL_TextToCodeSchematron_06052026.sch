                  <xsl:element name="assertionID">a-4482-536-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">If either value[xsi:type="CD"]/@sdtc:valueSet or
                     value[xsi:type="CD"]/@sdtc:valueSetVersion is present then both
                     value[xsi:type="CD"]/@sdtc:valueSet and
