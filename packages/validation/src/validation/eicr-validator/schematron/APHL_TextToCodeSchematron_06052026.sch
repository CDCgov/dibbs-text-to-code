      <xsl:choose>
         <xsl:when
            test="not(cda:performer/cda:assignedEntity) or cda:performer/cda:assignedEntity[count(cda:id) &gt; 0]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1098-8303</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This assignedEntity SHALL contain at least one [1..*]
