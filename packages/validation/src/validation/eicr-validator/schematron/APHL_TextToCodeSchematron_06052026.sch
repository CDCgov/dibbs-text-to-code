      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:documentationOf/cda:serviceEvent/cda:performer) or cda:documentationOf/cda:serviceEvent/cda:performer[@typeCode and @typeCode = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = '2.16.840.1.113883.1.11.19601']/voc:code/@value]"/>
         <xsl:otherwise>
