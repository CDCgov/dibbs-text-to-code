                     urn:oid:2.16.840.1.113883.10.20.22.5.4) (CONF:1198-5580).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(existence_schema_tested)</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:legalAuthenticator/cda:signatureCode) or cda:legalAuthenticator/cda:signatureCode[@code = 'S']"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-5584</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This signatureCode SHALL contain exactly one [1..1]
                     @code="S" (CodeSystem: HL7ParticipationSignature urn:oid:2.16.840.1.113883.5.89
                     STATIC) (CONF:1198-5584).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(cda:legalAuthenticator/cda:signatureCode) or
                     cda:legalAuthenticator/cda:signatureCode[@code='S']</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
