      priority="3999" mode="M86">
      <xsl:choose>
         <xsl:when
            test="not(cda:substanceAdministration/cda:id) or cda:substanceAdministration/cda:id[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
