                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> (cda:effectiveTime/@value) or
                     cda:effectiveTime/cda:low[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="(cda:effectiveTime/@value) or cda:effectiveTime/cda:low[@nullFlavor] or not(cda:effectiveTime/cda:low/@value) or string-length(cda:effectiveTime/cda:low/@value) &gt;= 8"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-encounter_effectiveTime-005</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Encounter effectiveTime low data element
                     @value attribute is not at least 8 characters (yyyymmdd)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> (cda:effectiveTime/@value) or
                     cda:effectiveTime/cda:low[@nullFlavor] or not(cda:effectiveTime/cda:low/@value)
                     or string-length(cda:effectiveTime/cda:low/@value) &gt;= 8</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="(cda:effectiveTime/@value) or cda:effectiveTime/cda:low[@nullFlavor] or not(cda:effectiveTime/cda:low/@value) or matches(normalize-space(cda:effectiveTime/cda:low/@value), '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$')"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-encounter_effectiveTime-005a</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Encounter effectiveTime low data element
                     @value attribute is not in valid CDA TS format
                     (YYYY[MM[DD[HH[MM[SS[.s+]]]]]][±HHMM])</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">( cda:effectiveTime/@value) or
                     cda:effectiveTime/cda:low[@nullFlavor] or not(cda:effectiveTime/cda:low/@value)
                     or matches(normalize-space(cda:effectiveTime/cda:low/@value),
                     '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$')</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(sdtc:dischargeDispositionCode) or sdtc:dischargeDispositionCode[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID"
                     >dq-encounter_dischargeDisposition-001</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Encounter sdtc:dischargeDispositionCode
