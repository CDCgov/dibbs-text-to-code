      <xsl:choose>
         <xsl:when
            test="count(cda:participant) = count(cda:participant/cda:associatedEntity[cda:associatedPerson | cda:scopingOrganization])"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-10006-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">**SHALL** contain associatedEntity/associatedPerson
                     *AND/OR* associatedEntity/scopingOrganization (CONF:1198-10006).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:participant) = count(
