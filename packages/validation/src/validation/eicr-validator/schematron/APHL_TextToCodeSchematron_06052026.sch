                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">
                     cda:consumable/cda:manufacturedProduct[cda:templateId/@root='2.16.840.1.113883.10.20.22.4.23']/cda:manufacturedMaterial/cda:code[string-length(@code)
                     &gt; 0]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:consumable/cda:manufacturedProduct[cda:templateId/@root = '2.16.840.1.113883.10.20.22.4.23']/cda:manufacturedMaterial/cda:code) or cda:consumable/cda:manufacturedProduct[cda:templateId/@root = '2.16.840.1.113883.10.20.22.4.23']/cda:manufacturedMaterial/cda:code[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-planned-medication-002</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned Medication data element is
