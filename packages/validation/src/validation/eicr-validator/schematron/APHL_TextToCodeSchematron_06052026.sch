               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID"
                     >dq-encompassingEncounter-provider-002</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: The encompassing encounter provider ID
