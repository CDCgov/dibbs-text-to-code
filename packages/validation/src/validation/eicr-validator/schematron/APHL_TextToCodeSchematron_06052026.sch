                     not(cda:effectiveTime/cda:high/@value) or
                     matches(normalize-space(cda:effectiveTime/cda:high/@value),
                     '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$')</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:code) or cda:code[@nullFlavor] or cda:code/@code = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = '2.16.840.1.113883.1.11.13955']/voc:code/@value or cda:code/cda:translation/@code = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = '2.16.840.1.113883.1.11.13955']/voc:code/@value"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-encompassingEncounterCode-007</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Encompassing encounter code data element
