               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-8715</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">SHALL contain exactly one [1..1] effectiveTime
