      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:targetSiteCode) or cda:targetSiteCode[@nullFlavor] or count(cda:targetSiteCode[@code]) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-labOrder-targetSiteCode-002</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned observation targetSiteCode data
                     element has no @code attribute</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:targetSiteCode) or
                     cda:targetSiteCode[@nullFlavor] or count(cda:targetSiteCode[@code]) =
                     1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:targetSiteCode) or cda:targetSiteCode[@nullFlavor] or cda:targetSiteCode/@code = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = '2.16.840.1.113883.3.88.12.3221.8.9']/voc:code/@value or cda:targetSiteCode/cda:translation/@code = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = '2.16.840.1.113883.3.88.12.3221.8.9']/voc:code/@value"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-labOrder-targetSiteCode-003</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned observation targetSiteCode data
                     element is not in valueset Body Site</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:targetSiteCode) or
                     cda:targetSiteCode[@nullFlavor] or cda:targetSiteCode/@code =
                     document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid
                     = '2.16.840.1.113883.3.88.12.3221.8.9']/voc:code/@value or
                     cda:targetSiteCode/cda:translation/@code =
                     document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid
                     = '2.16.840.1.113883.3.88.12.3221.8.9']/voc:code/@value</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:performer/cda:assignedEntity/cda:representedOrganization) or cda:performer/cda:assignedEntity/cda:representedOrganization[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-labOrder-performer-001</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned observation performer
                     representedOrgnaization data element is nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">
                     not(cda:performer/cda:assignedEntity/cda:representedOrganization) or
                     cda:performer/cda:assignedEntity/cda:representedOrganization[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:performer/cda:assignedEntity/cda:representedOrganization) or cda:performer/cda:assignedEntity/cda:representedOrganization[@nullFlavor] or cda:performer/cda:assignedEntity/cda:representedOrganization/cda:name[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-labOrder-performer-002</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned observation performer
                     representedOrgnaization name data element is nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">
                     not(cda:performer/cda:assignedEntity/cda:representedOrganization) or
                     cda:performer/cda:assignedEntity/cda:representedOrganization[@nullFlavor] or
                     cda:performer/cda:assignedEntity/cda:representedOrganization/cda:name[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:performer/cda:assignedEntity/cda:representedOrganization) or cda:performer/cda:assignedEntity/cda:representedOrganization[@nullFlavor] or cda:performer/cda:assignedEntity/cda:representedOrganization/cda:telecom[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-labOrder-performer-003</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned observation performer
                     representedOrgnaization telecom data element is nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">
                     not(cda:performer/cda:assignedEntity/cda:representedOrganization) or
                     cda:performer/cda:assignedEntity/cda:representedOrganization[@nullFlavor] or
                     cda:performer/cda:assignedEntity/cda:representedOrganization/cda:telecom[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:performer/cda:assignedEntity/cda:representedOrganization) or cda:performer/cda:assignedEntity/cda:representedOrganization[@nullFlavor] or cda:performer/cda:assignedEntity/cda:representedOrganization/cda:id[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-labOrder-performer-004</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Planned observation performer
                     representedOrgnaization id data element is nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">
                     not(cda:performer/cda:assignedEntity/cda:representedOrganization) or
                     cda:performer/cda:assignedEntity/cda:representedOrganization[@nullFlavor] or
                     cda:performer/cda:assignedEntity/cda:representedOrganization/cda:id[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M81"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M81"/>
   <xsl:template match="//cda:patient" priority="3999" mode="M82">
      <xsl:choose>
         <xsl:when
            test="not(sdtc:deceasedTime) or sdtc:deceasedTime[@nullFlavor] or count(sdtc:deceasedTime[@value]) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-deceasedTime-001</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Patient sdtc:deceasedTime data element
                     has no @value attribute</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(sdtc:deceasedTime) or sdtc:deceasedTime[@nullFlavor]
                     or count(sdtc:deceasedTime[@value]) = 1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(sdtc:deceasedTime) or sdtc:deceasedTime[@nullFlavor] or string-length(sdtc:deceasedTime/@value) &gt;= 8"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-deceasedTime-002</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Patient sdtc:deceasedTime data element
                     @value attribute is not at least 8 characters (yyyymmdd)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(sdtc:deceasedTime) or sdtc:deceasedTime[@nullFlavor]
                     or string-length(sdtc:deceasedTime/@value) &gt;= 8</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(sdtc:deceasedTime) or sdtc:deceasedTime[@nullFlavor] or not(sdtc:deceasedTime/@value) or matches(normalize-space(sdtc:deceasedTime/@value), '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$')"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-deceasedTime-002a</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Patient sdtc:deceasedTime data element
                     @value attribute is not in valid CDA TS format
                     (YYYY[MM[DD[HH[MM[SS[.s+]]]]]][±HHMM])</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(sdtc:deceasedTime) or sdtc:deceasedTime[@nullFlavor]
                     or not(sdtc:deceasedTime/@value) or
                     matches(normalize-space(sdtc:deceasedTime/@value),
                     '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$')</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M82"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M82"/>
   <xsl:template match="//cda:observation[cda:templateId[@root = '2.16.840.1.113883.10.20.22.4.4']]"
      priority="3999" mode="M83">
      <xsl:choose>
         <xsl:when test="not(cda:code) or cda:code[@nullFlavor] or count(cda:code/@code) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-problemObservation-code-002</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Problem observation code data element
                     has no @code attribute</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:code) or cda:code[@nullFlavor] or
                     count(cda:code/@code) = 1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:code) or cda:code[@nullFlavor] or not(cda:code/@code) or cda:code/@code = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = 'urn:hl7ii:2.16.840.1.113883.3.88.12.3221.7.2:2014-09-02']/voc:code/@value or cda:code/@code = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = '2.16.840.1.113883.3.88.12.3221.7.2']/voc:code/@value or cda:code/cda:translation/@code = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = 'urn:hl7ii:2.16.840.1.113883.3.88.12.3221.7.2:2014-09-02']/voc:code/@value or cda:code/cda:translation/@code = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = '2.16.840.1.113883.3.88.12.3221.7.2']/voc:code/@value"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-problemObservation-code-003</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Problem observation code data element
                     AND its translation are not in valueset Problem Type</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:code) or cda:code[@nullFlavor] or
                     not(cda:code/@code) or cda:code/@code =
                     document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid
                     = 'urn:hl7ii:2.16.840.1.113883.3.88.12.3221.7.2:2014-09-02']/voc:code/@value or
                     cda:code/@code =
                     document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid
                     = '2.16.840.1.113883.3.88.12.3221.7.2']/voc:code/@value or
                     cda:code/cda:translation/@code =
                     document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid
                     = 'urn:hl7ii:2.16.840.1.113883.3.88.12.3221.7.2:2014-09-02']/voc:code/@value or
                     cda:code/cda:translation/@code =
                     document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid
                     = '2.16.840.1.113883.3.88.12.3221.7.2']/voc:code/@value</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="not(cda:code) or cda:code[@nullFlavor] or count(cda:code/@codeSystem) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-problemObservation-code-004</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Problem observation code data element
                     has no @codeSystem attribute</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:code) or cda:code[@nullFlavor] or
                     count(cda:code/@codeSystem) = 1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:code) or cda:code[@nullFlavor] or count(cda:code[@codeSystem = '']) = 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-problemObservation-code-005</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Problem observation code data element
                     @codeSystem attribute is blank</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:code) or cda:code[@nullFlavor] or
                     count(cda:code[@codeSystem = '']) = 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="not(cda:value) or cda:value[@nullFlavor] or count(cda:value/@code) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-problemObservation-value-001</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Problem observation value data element
                     has no @code attribute</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:value) or cda:value[@nullFlavor] or
                     count(cda:value/@code) = 1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:value) or cda:value[@nullFlavor] or not(cda:value[@code]) or count(cda:value[@code = '']) = 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-problemObservation-value-002</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Problem observation value data element
                     @code attribute is blank</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:value) or cda:value[@nullFlavor] or
                     not(cda:value[@code]) or count(cda:value[@code = '']) = 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:value) or cda:value[@nullFlavor] or count(cda:value/@codeSystem) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-problemObservation-value-003</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Problem observation value data element
                     has no @codeSystem attribute</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:value) or cda:value[@nullFlavor] or
                     count(cda:value/@codeSystem) = 1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:value) or cda:value[@nullFlavor] or not(cda:value[@codeSystem]) or cda:value[@codeSystem = '2.16.840.1.113883.6.96'] or cda:value[@codeSystem = '2.16.840.1.113883.6.90'] or cda:value/cda:translation[@codeSystem = '2.16.840.1.113883.6.96'] or cda:value/cda:translation[@codeSystem = '2.16.840.1.113883.6.90']"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-problemObservation-value-004</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Problem observation value data element
                     and translation @codeSystem attribute is not SNOMED 2.16.840.1.113883.6.96 or
                     ICD10 2.16.840.1.113883.6.90</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:value) or cda:value[@nullFlavor] or
                     not(cda:value[@codeSystem]) or cda:value[@codeSystem =
                     '2.16.840.1.113883.6.96'] or cda:value[@codeSystem = '2.16.840.1.113883.6.90']
                     or cda:value/cda:translation[@codeSystem = '2.16.840.1.113883.6.96'] or
                     cda:value/cda:translation[@codeSystem = '2.16.840.1.113883.6.90']</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M83"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M83"/>
   <xsl:template match="//cda:organizer[cda:templateId[@root = '2.16.840.1.113883.10.20.22.4.1']]"
      priority="3999" mode="M84">
      <xsl:choose>
         <xsl:when test="not(cda:code) or cda:code[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-resultOrganizer-code-001</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Result organizer code data element is
                     nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:code) or
                     cda:code[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="not(cda:code) or cda:code[@nullFlavor] or count(cda:code/@code) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-resultOrganizer-code-002</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Result organizer code data element has
                     no code</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:code) or cda:code[@nullFlavor] or
                     count(cda:code/@code) = 1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
