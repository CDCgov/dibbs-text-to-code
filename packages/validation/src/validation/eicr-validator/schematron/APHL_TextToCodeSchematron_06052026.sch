                     not(sdtc:dischargeDispositionCode[not(@nullFlavor)]) or
                     count(sdtc:dischargeDispositionCode/@code) = 1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M94"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M94"/>
