      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:effectiveTime/cda:high) or cda:effectiveTime/cda:high[@nullFlavor] or not(cda:effectiveTime/cda:high/@value) or matches(normalize-space(cda:effectiveTime/cda:high/@value), '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$')"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-encompassingEncounter-008a</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Encompassing encounter effectiveTime
                     high data element @value attribute is not in valid CDA TS format
                     (YYYY[MM[DD[HH[MM[SS[.s+]]]]]][±HHMM])</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:effectiveTime/cda:high) or
