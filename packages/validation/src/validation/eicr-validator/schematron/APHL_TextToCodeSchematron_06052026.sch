               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M275"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M275"/>
   <xsl:template
      match="cda:act[cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.45' and @extension = '2021-01-01']]"
      priority="3999" mode="M276">
      <xsl:choose>
         <xsl:when test="@classCode = 'ACT'"/>
         <xsl:otherwise>
