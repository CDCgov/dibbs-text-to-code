         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-sdtc-deceasedInd-001</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Patient sdtc:deceasedInd data element is
                     nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(sdtc:deceasedInd) or
                     sdtc:deceasedInd[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="(sdtc:deceasedInd[@nullFlavor]) or (not(sdtc:deceasedInd) or (sdtc:deceasedInd[@value = 'true'] or sdtc:deceasedInd[@value = 'false']))"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-sdtc-deceasedInd-002</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Patient sdtc:deceasedInd data element is
                     not 'true' or 'false'</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> (sdtc:deceasedInd[@nullFlavor]) or
                     (not(sdtc:deceasedInd) or (sdtc:deceasedInd[@value = 'true'] or
                     sdtc:deceasedInd[@value = 'false']))</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
