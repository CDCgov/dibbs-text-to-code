      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:effectiveTime) or cda:effectiveTime[@nullFlavor] or not(cda:effectiveTime[@value]) or string-length(cda:effectiveTime/@value) &gt;= 8"/>
         <xsl:otherwise>
