      </xsl:choose>
      <xsl:choose>
         <xsl:when test="not(cda:performer) or cda:performer[count(cda:assignedEntity) = 1]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-8726</xsl:element>
                  <xsl:element name="flag"/>
