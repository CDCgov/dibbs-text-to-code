               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-5598-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This assignedPerson SHALL contain at least one [1..*]
                     US Realm Person Name (PN.US.FIELDED) (identifier:
                     urn:oid:2.16.840.1.113883.10.20.22.5.1.1) (CONF:1198-5598).</xsl:element>
