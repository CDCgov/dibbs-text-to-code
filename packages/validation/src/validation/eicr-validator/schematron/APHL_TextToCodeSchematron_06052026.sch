                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:effectiveTime/cda:low) or
                     cda:effectiveTime/cda:low[@nullFlavor] or not(cda:effectiveTime/cda:low/@value)
                     or not(string-length(cda:effectiveTime/cda:low/@value) &gt;= 8) or
                     matches(normalize-space(cda:effectiveTime/cda:low/@value),
                     '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$')</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
