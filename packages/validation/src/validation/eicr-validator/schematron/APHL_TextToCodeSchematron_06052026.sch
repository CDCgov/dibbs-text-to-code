                  <xsl:element name="assertionID">dq-dataCheck-sdtc-ethnicGroupCode</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">DATA CHECK: this eICR has at least one patient sdtc:ethnicGroupCode data element</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(//sdtc:ethnicGroupCode) = 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
