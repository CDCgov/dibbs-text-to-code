      <xsl:choose>
         <xsl:when test="
               cda:addr[@nullFlavor] or not(cda:addr/cda:postalCode) or cda:addr/cda:postalCode[@nullFlavor] or not(count(cda:addr[cda:postalCode = '']) = 0) or (every $pc in cda:addr/cda:postalCode
                  satisfies matches(replace(normalize-space($pc), '-', ''), '^(\d{5}|\d{9})$'))"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-patientAddress-015</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Patient address postalCode must be 5 or
                     9 digits (e.g., 12345 or 12345-6789)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> cda:addr[@nullFlavor] or not(cda:addr/cda:postalCode) or
                     cda:addr/cda:postalCode[@nullFlavor] or not(count(cda:addr[cda:postalCode =
                     '']) = 0) or (every $pc in cda:addr/cda:postalCode satisfies
                     matches(replace(normalize-space($pc), '-', ''),
                     '^(\d{5}|\d{9})$'))</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M71"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M71"/>
