                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >cda:manufacturedProduct/cda:manufacturedMaterial/cda:code[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M56"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M56"/>
   <xsl:template match="//cda:recordTarget/cda:patientRole" priority="3999" mode="M57">
      <xsl:choose>
         <xsl:when
            test="not(//cda:recordTarget/cda:patientRole/cda:telecom) or count(//cda:recordTarget/cda:patientRole/cda:telecom[@nullFlavor]) = 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-patientRoleTelecom-001</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Patient telecom data element is
                     nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(//cda:recordTarget/cda:patientRole/cda:telecom) or
                     count(//cda:recordTarget/cda:patientRole/cda:telecom[@nullFlavor]) =
                     0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(//cda:recordTarget/cda:patientRole/cda:telecom) or //cda:recordTarget/cda:patientRole/cda:telecom[contains(@value, 'tel:')]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-patientRoleTelecom-002</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Patient telecom data element does not
                     include a telephone value which is identified with prefix =
                     "tel:"</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(//cda:recordTarget/cda:patientRole/cda:telecom) or
                     //cda:recordTarget/cda:patientRole/cda:telecom[contains(@value,
                     'tel:')]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(//cda:recordTarget/cda:patientRole/cda:telecom) or //cda:recordTarget/cda:patientRole/cda:telecom[contains(@value, 'mailto:')]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-patientRoleTelecom-003</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Patient telecom data element does not
                     include an email value which is identified with prefix =
                     "mailto:"</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(//cda:recordTarget/cda:patientRole/cda:telecom) or
                     //cda:recordTarget/cda:patientRole/cda:telecom[contains(@value,
                     'mailto:')]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M57"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M57"/>
   <xsl:template match="//cda:patient" priority="3999" mode="M58">
      <xsl:choose>
         <xsl:when
            test="not(cda:administrativeGenderCode) or cda:administrativeGenderCode[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-administrativeGenderCode-001</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Patient administrativeGenderCode data
                     element is nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:administrativeGenderCode) or
                     cda:administrativeGenderCode[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="(cda:administrativeGenderCode[@nullFlavor]) or (not(cda:administrativeGenderCode) or (cda:administrativeGenderCode[@code = 'M'] or cda:administrativeGenderCode[@code = 'F'] or cda:administrativeGenderCode[@code = 'UN']))"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-administrativeGenderCode-002</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Patient administrativeGenderCode data
                     element is not in ValueSet Administrative Gender (HL7 V3)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> (cda:administrativeGenderCode[@nullFlavor]) or
                     (not(cda:administrativeGenderCode) or (cda:administrativeGenderCode[@code =
                     'M'] or cda:administrativeGenderCode[@code = 'F'] or
                     cda:administrativeGenderCode[@code = 'UN']))</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="(cda:administrativeGenderCode[@nullFlavor]) or (not(cda:administrativeGenderCode) or ((count(cda:administrativeGenderCode[@codeSystem]) = 1 and count(cda:administrativeGenderCode[@codeSystem = '2.16.840.1.113883.5.1']) = 1)))"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-administrativeGenderCode-003</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Patient administrativeGenderCode data
                     element @codeSystem attribute is not 2.16.840.1.113883.5.1</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> (cda:administrativeGenderCode[@nullFlavor]) or
                     (not(cda:administrativeGenderCode) or
                     ((count(cda:administrativeGenderCode[@codeSystem]) = 1 and
                     count(cda:administrativeGenderCode[@codeSystem = '2.16.840.1.113883.5.1']) =
                     1)))</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M58"/>
