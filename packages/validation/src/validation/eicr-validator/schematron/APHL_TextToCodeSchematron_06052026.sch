                  </xsl:element>
                  <xsl:element name="test">count(cda:value[@xsi:type='CD'])=1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:value[@xsi:type = 'CD']/cda:translation) or cda:value[@xsi:type = 'CD']/cda:translation[@code]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4482-477</xsl:element>
                  <xsl:element name="flag"/>
