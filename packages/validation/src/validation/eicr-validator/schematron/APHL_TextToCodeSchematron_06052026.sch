            test="(count(cda:componentOf/cda:encompassingEncounter/cda:code[@code = 'PHC2237']) = 0 and count(cda:componentOf/cda:encompassingEncounter/cda:responsibleParty) = 1 and count(cda:componentOf/cda:encompassingEncounter/cda:location) = 1) or count(cda:componentOf/cda:encompassingEncounter/cda:code[@code = 'PHC2237']) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-594-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">EncompassingEncounter/responsibleParty and
                     encompassingEncounter/location SHALL be present when not(
                     encompassingEncounter/code="PHC2237" | codeSystem="2.16.840.1.114222.4.5.274" |
                     codeSystemName="PHIN VS (CDC Local Coding System)" (External Encounter))
                     (CONF:4527-594).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >(count(cda:componentOf/cda:encompassingEncounter/cda:code[@code='PHC2237'])=0
                     and count(cda:componentOf/cda:encompassingEncounter/cda:responsibleParty)=1 and
                     count(cda:componentOf/cda:encompassingEncounter/cda:location)=1) or
                     count(cda:componentOf/cda:encompassingEncounter/cda:code[@code='PHC2237'])=1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:recordTarget/cda:patientRole/cda:patient/cda:guardian) or cda:recordTarget/cda:patientRole/cda:patient/cda:guardian[count(cda:telecom) &gt; 0]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-116</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">The guardian, if present, SHALL contain at least one
                     [1..*] telecom (CONF:4527-116).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >not(cda:recordTarget/cda:patientRole/cda:patient/cda:guardian) or
                     cda:recordTarget/cda:patientRole/cda:patient/cda:guardian[count(cda:telecom)
                     &gt; 0]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:recordTarget/cda:patientRole/cda:patient/cda:guardian) or cda:recordTarget/cda:patientRole/cda:patient/cda:guardian[count(cda:guardianPerson) = 1]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-129</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">The guardian, if present, SHALL contain exactly one
                     [1..1] guardianPerson (CONF:4527-129).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >not(cda:recordTarget/cda:patientRole/cda:patient/cda:guardian) or
                     cda:recordTarget/cda:patientRole/cda:patient/cda:guardian[count(cda:guardianPerson)=1]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="(not(cda:recordTarget/cda:patientRole/cda:patient/sdtc:deceasedInd[@value = 'true']) and (not(cda:recordTarget/cda:patientRole/cda:patient/sdtc:deceasedTime) or cda:recordTarget/cda:patientRole/cda:patient/sdtc:deceasedTime[@nullFlavor])) or (cda:recordTarget/cda:patientRole/cda:patient/sdtc:deceasedInd[@value = 'true'] and cda:recordTarget/cda:patientRole/cda:patient/sdtc:deceasedTime and cda:recordTarget/cda:patientRole/cda:patient/sdtc:deceasedTime[not(@nullFlavor)])"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-403-c</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">If sdtc:deceasedInd is true then sdtc:deceasedTime
                     *SHALL* be present and *SHALL NOT* contain @nullFlavor. If sdtc:deceasedInd is
                     false then sdtc:deceasedTime *SHALL NOT* be present or sdtc:deceasedTime SHALL
                     be @nullFlavor (CONF:4527-403).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">(not
                     (cda:recordTarget/cda:patientRole/cda:patient/sdtc:deceasedInd[@value='true'] )
                     and (not(cda:recordTarget/cda:patientRole/cda:patient/sdtc:deceasedTime) or
                     cda:recordTarget/cda:patientRole/cda:patient/sdtc:deceasedTime[@nullFlavor]))
                     or
                     (cda:recordTarget/cda:patientRole/cda:patient/sdtc:deceasedInd[@value='true']
                     and cda:recordTarget/cda:patientRole/cda:patient/sdtc:deceasedTime and
                     cda:recordTarget/cda:patientRole/cda:patient/sdtc:deceasedTime[not(@nullFlavor)]
                     )</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="cda:recordTarget/cda:patientRole/cda:patient[count(cda:languageCommunication) &gt; 0]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-130</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This patient SHALL contain at least one [1..*]
                     languageCommunication (CONF:4527-130).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >cda:recordTarget/cda:patientRole/cda:patient[count(cda:languageCommunication)
                     &gt; 0]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="cda:recordTarget/cda:patientRole/cda:patient[count(sdtc:deceasedInd) = 1]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-404</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">This patient SHALL contain exactly one [1..1]
                     sdtc:deceasedInd (CONF:4527-404).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
