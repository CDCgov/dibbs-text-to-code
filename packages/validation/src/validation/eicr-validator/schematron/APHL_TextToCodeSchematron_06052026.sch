               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-5252</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] templateId
                     (CONF:1198-5252) such that it SHALL contain exactly one [1..1]
                     @root="2.16.840.1.113883.10.20.22.1.1" (CONF:1198-10036). SHALL contain exactly
                     one [1..1] @extension="2015-08-01" (CONF:1198-32503).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >count(cda:templateId[@root='2.16.840.1.113883.10.20.22.1.1'][@extension='2015-08-01'])=1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M198"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M198"/>
   <xsl:template
      match="cda:encounter[cda:templateId[@root = '2.16.840.1.113883.10.20.22.4.49' and @extension = '2015-08-01']]"
      priority="3999" mode="M199">
      <xsl:choose>
         <xsl:when
            test="count(cda:templateId[@root = '2.16.840.1.113883.10.20.22.4.49'][@extension = '2015-08-01']) = 1"/>
         <xsl:otherwise>
