   <xsl:template match="text()" priority="-1" mode="M53"/>
   <xsl:template
      match="//cda:substanceAdministration[cda:templateId/@root = '2.16.840.1.113883.10.20.22.4.42' or (cda:templateId[@root = '2.16.840.1.113883.10.20.22.4.16'] and @moodCode != 'EVN')][not(ancestor::cda:section[cda:templateId[@root = '2.16.840.1.113883.10.20.22.2.38']])]"
      priority="3999" mode="M54">
      <xsl:choose>
         <xsl:when
            test="cda:consumable/cda:manufacturedProduct[cda:templateId/@root = '2.16.840.1.113883.10.20.22.4.23']/cda:manufacturedMaterial/cda:code"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-planned-medication-001</xsl:element>
