                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">cda:value[@sdtc:valueSet and @sdtc:valueSetVersion] or
                     cda:value[ not(@sdtc:valueSet or @sdtc:valueSetVersion)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="@classCode = 'OBS'"/>
         <xsl:otherwise>
