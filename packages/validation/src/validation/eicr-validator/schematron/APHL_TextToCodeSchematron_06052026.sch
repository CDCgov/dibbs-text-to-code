   <xsl:template match="text()" priority="-1" mode="M73"/>
   <xsl:template match="//cda:ClinicalDocument/cda:componentOf/cda:encompassingEncounter"
      priority="3999" mode="M74">
      <xsl:choose>
         <xsl:when
            test="not(cda:effectiveTime/cda:low) or cda:effectiveTime/cda:low[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-encompassingEncounter-002</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Encompassing encounter effectiveTime low
                     data element is nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:effectiveTime/cda:low) or
                     cda:effectiveTime/cda:low[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:effectiveTime/cda:low) or cda:effectiveTime/cda:low[@nullFlavor] or count(cda:effectiveTime/cda:low/@value) &gt; 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-encompassingEncounter-003</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Encompassing encounter effectiveTime low
                     data element has no @value attribute</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:effectiveTime/cda:low) or
                     cda:effectiveTime/cda:low[@nullFlavor] or
                     count(cda:effectiveTime/cda:low/@value) &gt; 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:effectiveTime/cda:low) or cda:effectiveTime/cda:low[@nullFlavor] or string-length(cda:effectiveTime/cda:low/@value) &gt;= 8"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-encompassingEncounter-004</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Encompassing encounter effectiveTime low
                     data element @value attribute is not at least 8 characters
                     (yyyymmdd)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:effectiveTime/cda:low) or
                     cda:effectiveTime/cda:low[@nullFlavor] or
                     string-length(cda:effectiveTime/cda:low/@value) &gt;= 8</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:effectiveTime/cda:low) or cda:effectiveTime/cda:low[@nullFlavor] or not(cda:effectiveTime/cda:low/@value) or not(string-length(cda:effectiveTime/cda:low/@value) &gt;= 8) or matches(normalize-space(cda:effectiveTime/cda:low/@value), '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$')"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-encompassingEncounter-004a</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Encompassing encounter effectiveTime low
                     data element @value attribute is not in valid CDA TS format
