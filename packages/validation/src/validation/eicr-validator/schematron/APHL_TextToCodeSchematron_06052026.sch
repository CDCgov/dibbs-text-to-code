      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:componentOf/cda:encompassingEncounter) or cda:componentOf/cda:encompassingEncounter[count(cda:effectiveTime) = 1]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-9958</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This encompassingEncounter SHALL contain exactly one
                     [1..1] effectiveTime (CONF:1198-9958).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(cda:componentOf/cda:encompassingEncounter) or
                     cda:componentOf/cda:encompassingEncounter[count(cda:effectiveTime)=1]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
