            test="not(sdtc:dischargeDispositionCode) or sdtc:dischargeDispositionCode[@nullFlavor] or not(sdtc:dischargeDispositionCode/@code) or not(count(sdtc:dischargeDispositionCode[@code = '']) = 0) or sdtc:dischargeDispositionCode[@code = ''] or (sdtc:dischargeDispositionCode/@code = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = '2.16.840.1.113883.12.112']/voc:code/@value and sdtc:dischargeDispositionCode/@codeSystem = '2.16.840.1.113883.12.112') or (sdtc:dischargeDispositionCode/cda:translation/@code = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = '2.16.840.1.113883.12.112']/voc:code/@value and sdtc:dischargeDispositionCode/cda:translation/@codeSystem = '2.16.840.1.113883.12.112') or (sdtc:dischargeDispositionCode/@code = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = '2.16.840.1.113883.6.301']/voc:code/@value and sdtc:dischargeDispositionCode/@codeSystem = '2.16.840.1.113883.6.301') or (sdtc:dischargeDispositionCode/cda:translation/@code = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = '2.16.840.1.113883.6.301']/voc:code/@value and sdtc:dischargeDispositionCode/cda:translation/@codeSystem = '2.16.840.1.113883.6.301')"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID"
                     >dq-encounter_dischargeDisposition-003</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Encounter sdtc:dischargeDispositionCode
                     data element and translation @code attribute are not in ValueSet HL7 Discharge
                     Disposition (2.16.840.1.113883.12.112) or NUBC UB-04 Discharge Status
                     (2.16.840.1.113883.6.301)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(sdtc:dischargeDispositionCode) or
                     sdtc:dischargeDispositionCode[@nullFlavor] or
                     not(sdtc:dischargeDispositionCode/@code) or
                     not(count(sdtc:dischargeDispositionCode[@code = '']) = 0) or
                     sdtc:dischargeDispositionCode[@code = ''] or
                     (sdtc:dischargeDispositionCode/@code =
                     document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid
                     = '2.16.840.1.113883.12.112']/voc:code/@value and
                     sdtc:dischargeDispositionCode/@codeSystem = '2.16.840.1.113883.12.112') or
                     (sdtc:dischargeDispositionCode/cda:translation/@code =
                     document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid
                     = '2.16.840.1.113883.12.112']/voc:code/@value and
                     sdtc:dischargeDispositionCode/cda:translation/@codeSystem =
                     '2.16.840.1.113883.12.112') or (sdtc:dischargeDispositionCode/@code =
                     document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid
                     = '2.16.840.1.113883.6.301']/voc:code/@value and
                     sdtc:dischargeDispositionCode/@codeSystem = '2.16.840.1.113883.6.301') or
                     (sdtc:dischargeDispositionCode/cda:translation/@code =
                     document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid
                     = '2.16.840.1.113883.6.301']/voc:code/@value and
                     sdtc:dischargeDispositionCode/cda:translation/@codeSystem =
                     '2.16.840.1.113883.6.301')</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(sdtc:dischargeDispositionCode) or not(sdtc:dischargeDispositionCode[not(@nullFlavor)]) or count(sdtc:dischargeDispositionCode/@code) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID"
