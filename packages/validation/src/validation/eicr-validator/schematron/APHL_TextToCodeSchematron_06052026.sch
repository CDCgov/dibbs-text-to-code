      <xsl:choose>
         <xsl:when
            test="not(cda:substanceAdministration/cda:id) or cda:substanceAdministration/cda:id[@nullFlavor] or count(cda:substanceAdministration/cda:id/@root) = count(cda:substanceAdministration/cda:id)"/>
