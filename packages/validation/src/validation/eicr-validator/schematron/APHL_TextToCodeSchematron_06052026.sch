      <xsl:choose>
         <xsl:when
            test="not(cda:value) or (cda:value[@nullFlavor]) or count(cda:value[@codeSystem = '']) = 1 or cda:value[@codeSystem = '2.16.840.1.113883.6.96'] or cda:value/cda:translation[@codeSystem = '2.16.840.1.113883.6.96'] or cda:value[@codeSystem = '2.16.840.1.113883.6.90'] or cda:value/cda:translation[@codeSystem = '2.16.840.1.113883.6.90']"/>
