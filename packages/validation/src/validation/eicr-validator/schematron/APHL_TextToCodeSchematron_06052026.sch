                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="(cda:value/cda:translation/@sdtc:valueSet and cda:value/cda:translation/@sdtc:valueSetVersion) or (not(cda:value/cda:translation/@sdtc:valueSet) and not(cda:value/cda:translation/@sdtc:valueSetVersion))"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
