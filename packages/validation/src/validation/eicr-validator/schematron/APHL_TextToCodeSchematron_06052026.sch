                     CDA Release 2, section 4.3.5.1) (CONF:1198-15972).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:code/cda:originalText/cda:reference[@value])=0
                     or starts-with(cda:code/cda:originalText/cda:reference/@value,
                     '#')</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
