                     = '2.16.840.1.113883.1.11.13955']/voc:code/@value or
                     cda:code/cda:translation/@code =
                     document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid
                     = '2.16.840.1.113883.1.11.13955']/voc:code/@value</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
