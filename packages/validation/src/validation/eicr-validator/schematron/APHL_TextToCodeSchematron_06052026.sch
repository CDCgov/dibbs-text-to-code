            test="not(cda:id) or cda:id[@nullFlavor] or count(cda:id[@root = '']) &gt; 0 or (matches(cda:id/@root, '^[0-2](\.(0|[1-9][0-9]*))+$') or matches(cda:id/@root, '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'))"/>
