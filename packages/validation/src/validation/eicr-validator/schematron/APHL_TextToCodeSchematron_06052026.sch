      <xsl:choose>
         <xsl:when
            test="not(cda:statusCode) or cda:statusCode[@nullFlavor] or (cda:templateId[@root = '2.16.840.1.113883.10.20.22.4.42'] and cda:statusCode/@code = 'active') or (cda:templateId[@root = '2.16.840.1.113883.10.20.22.4.16'] and @moodCode != 'EVN' and cda:statusCode/@code = document('eCR_3.1.1_DataQualityVocabulary.xml')/voc:systems/voc:system[@valueSetOid = '2.16.840.1.113762.1.4.1099.11']/voc:code/@value)"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
