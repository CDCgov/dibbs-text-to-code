      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(cda:code) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-9045</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] code, which SHOULD be
