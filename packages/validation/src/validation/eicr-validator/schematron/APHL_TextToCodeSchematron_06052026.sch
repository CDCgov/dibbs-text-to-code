      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:effectiveTime) or cda:effectiveTime[@nullFlavor] or (not(cda:effectiveTime[@value]) and not(cda:effectiveTime/cda:low[@value])) or matches(normalize-space(cda:effectiveTime/@value), '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$') or matches(normalize-space(cda:effectiveTime/cda:low/@value), '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$')"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-planned-medication-time-003a</xsl:element>
