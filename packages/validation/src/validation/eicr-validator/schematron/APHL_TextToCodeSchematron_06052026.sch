      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(//cda:observation[cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.3']]) = 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
