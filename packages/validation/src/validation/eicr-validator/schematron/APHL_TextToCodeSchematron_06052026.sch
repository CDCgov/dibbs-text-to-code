   <xsl:template match="text()" priority="-1" mode="M59"/>
   <xsl:template match="//cda:recordTarget/cda:patientRole/cda:patient" priority="3999" mode="M60">
      <xsl:choose>
         <xsl:when test="not(cda:raceCode) or cda:raceCode[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-raceCode-001</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Patient raceCode data element is
                     nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(cda:raceCode) or
                     cda:raceCode[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="(cda:raceCode[@nullFlavor]) or (not(cda:raceCode) or (cda:raceCode[@code = '1002-5'] or cda:raceCode[@code = '2028-9'] or cda:raceCode[@code = '2054-5'] or cda:raceCode[@code = '2076-8'] or cda:raceCode[@code = '2106-3']))"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-raceCode-002</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Patient raceCode data element is not in
                     ValueSet Race Category Excluding Nulls</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> (cda:raceCode[@nullFlavor]) or (not(cda:raceCode) or
                     (cda:raceCode[@code = '1002-5'] or cda:raceCode[@code = '2028-9'] or
                     cda:raceCode[@code = '2054-5'] or cda:raceCode[@code = '2076-8'] or
                     cda:raceCode[@code = '2106-3']))</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="(cda:raceCode[@nullFlavor]) or (not(cda:raceCode) or count(cda:raceCode[@codeSystem = '2.16.840.1.113883.6.238']) = 1)"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-raceCode-003</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Patient raceCode data element
