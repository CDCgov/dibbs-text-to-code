      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:effectiveTime/cda:low) or cda:effectiveTime/cda:low[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-problemObservation-003</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Problem observation effectiveTime low
                     data element is nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(cda:effectiveTime/cda:low) or
                     cda:effectiveTime/cda:low[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M55"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M55"/>
   <xsl:template
      match="//cda:substanceAdministration[cda:templateId[@root = '2.16.840.1.113883.10.20.22.4.52']]/cda:consumable"
      priority="3999" mode="M56">
      <xsl:choose>
         <xsl:when
            test="cda:manufacturedProduct/cda:manufacturedMaterial/cda:code[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-substanceAdministration-001</xsl:element>
