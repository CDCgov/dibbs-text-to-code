      </xsl:choose>
      <xsl:choose>
         <xsl:when test="@moodCode = 'EVN'"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-8711</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] @moodCode="EVN"
                     (CodeSystem: HL7ActMood urn:oid:2.16.840.1.113883.5.1001 STATIC)
                     (CONF:1198-8711).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">@moodCode='EVN'</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
