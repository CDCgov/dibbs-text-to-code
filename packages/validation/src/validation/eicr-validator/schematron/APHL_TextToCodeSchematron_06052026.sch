      <xsl:choose>
         <xsl:when test="count(cda:id) &gt; 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1098-8292</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain at least one [1..*] id
                     (CONF:1098-8292).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:id) &gt; 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(cda:code) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1098-8293</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] code
                     (CONF:1098-8293).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:code)=1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="count(cda:code/cda:originalText/cda:reference[@value]) = 0 or starts-with(cda:code/cda:originalText/cda:reference/@value, '#')"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1098-19189-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This reference/@value **SHALL** begin with a '#' and
                     **SHALL** point to its corresponding narrative (using the approach defined in
                     CDA Release 2, section 4.3.5.1) (CONF:1098-19189).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:code/cda:originalText/cda:reference[@value])=0
