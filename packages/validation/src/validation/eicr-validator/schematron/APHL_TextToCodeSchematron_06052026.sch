      <xsl:choose>
         <xsl:when
            test="count(cda:templateId[@root = '2.16.840.1.113883.10.20.22.4.12'][@extension = '2014-06-09']) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1098-8291</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] templateId
                     (CONF:1098-8291) such that it SHALL contain exactly one [1..1]
                     @root="2.16.840.1.113883.10.20.22.4.12" (CONF:1098-10519). SHALL contain
