                  <xsl:element name="test">count(//cda:observation[cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.40']])=0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(//cda:encounter/sdtc:dischargeDispositionCode)=0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_check</xsl:attribute>
                  <xsl:element name="assertionID">dq-dataCount-dischargeDispositionCode</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">
                     <xsl:text xml:space="preserve"> </xsl:text>
