            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_check</xsl:attribute>
                  <xsl:element name="assertionID">dq-dataCheck-guardian</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">DATA CHECK: this eICR has at least one patient guardian</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(//cda:guardian) = 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
