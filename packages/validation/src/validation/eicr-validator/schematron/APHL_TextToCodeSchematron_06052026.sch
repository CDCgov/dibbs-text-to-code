               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-8713</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain at least one [1..*] id
                     (CONF:1198-8713).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:id) &gt; 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="count(cda:code/cda:originalText/cda:reference[@value]) = 0 or starts-with(cda:code/cda:originalText/cda:reference/@value, '#')"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-15972-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This reference/@value **SHALL** begin with a '#' and
