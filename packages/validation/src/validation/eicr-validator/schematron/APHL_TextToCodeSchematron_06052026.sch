      <xsl:choose>
         <xsl:when
            test="not(cda:documentationOf/cda:serviceEvent/cda:effectiveTime) or cda:documentationOf/cda:serviceEvent/cda:effectiveTime[count(cda:low) = 1]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-14838</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This effectiveTime SHALL contain exactly one [1..1]
