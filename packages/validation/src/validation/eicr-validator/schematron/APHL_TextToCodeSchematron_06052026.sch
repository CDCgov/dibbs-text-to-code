      </xsl:choose>
      <xsl:choose>
         <xsl:when test="not(cda:id) or cda:id[@nullFlavor] or count(cda:id[@root]) = count(cda:id)"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
