                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4482-296</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] @negationInd
