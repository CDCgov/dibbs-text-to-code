   <xsl:template match="/" priority="3999" mode="M99">
      <xsl:choose>
         <xsl:when
            test="count(cda:ClinicalDocument/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2'][@extension = '2022-05-01']) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">fatals</xsl:attribute>
                  <xsl:element name="assertionID">Fatal-001</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Fatal: SHALL contain exactly one [1..1] templateId
                     (CONF:4482-96) such that it SHALL contain exactly one [1..1]
                     @root="2.16.840.1.113883.10.20.15.2" eICR Initial Public Health Case Report
                     Document (CONF:4482-95). SHALL contain exactly one [1..1]
                     @extension="2022-05-01" (CONF:4482-96).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:ClinicalDocument/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2'][@extension = '2022-05-01']) = 1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M99"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M99"/>
   <xsl:template match="/cda:ClinicalDocument" priority="3999" mode="M102">
      <xsl:choose>
         <xsl:when
            test="//cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.4'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.3'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.2'] or //cda:organizer/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.35'] or //cda:manufacturedProduct/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.36'] or //cda:substanceAdministration/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.38'] or //cda:act/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.41'] or //cda:procedure/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.42'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.43'] or //cda:procedure/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.44'] or //cda:act/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.45'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.46'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.5']"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">fatals</xsl:attribute>
                  <xsl:element name="assertionID">Fatal-005</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Fatal Error (Missing Trigger Diagnosis, Result, Result
                     Organizer, Lab Order, Medication Information, Immunization Medication
                     Information, Planned Act, Planned Observation, Planned Procedure, Procedure
                     Activity Act, Procedure Activity Observation, Procedure Activity Procedure, or
                     Initiation Reason): An eICR must contain at least one of Initial Case Report
                     Trigger Code Lab Test Order, Initial Case Report Trigger Code Problem
                     Observation, Initial Case Report Trigger Code Result Observation, Initial Case
                     Report Trigger Code Medication Information, Initial Case Report Trigger Code
                     Result Organizer, Initial Case Report Trigger Code Immunization Medication
                     Information, Initial Case Report Trigger Code Planned Act, Initial Case Report
                     Trigger Code Planned Observation, Initial Case Report Trigger Code Planned
                     Procedure, Initial Case Report Trigger Code Procedure Activity Act, Initial
                     Case Report Trigger Code Procedure Activity Observation, Initial Case Report
                     Trigger Code Procedure Activity Procedure, or Initial Case Report Initiation
                     Reason Observation. (Rule: validate_one_trigger_presence)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">//cda:observation/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.4'] or //cda:observation/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.3'] or //cda:observation/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.2'] or //cda:organizer/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.35'] or
                     //cda:manufacturedProduct/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.36'] or
                     //cda:substanceAdministration/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.38'] or //cda:act/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.41'] or //cda:procedure/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.42'] or //cda:observation/cda:templateId[@root
                     = '2.16.840.1.113883.10.20.15.2.3.43'] or //cda:procedure/cda:templateId[@root
                     = '2.16.840.1.113883.10.20.15.2.3.44'] or //cda:act/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.45'] or //cda:observation/cda:templateId[@root
                     = '2.16.840.1.113883.10.20.15.2.3.46'] or
                     //cda:observation/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.5']</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M102"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M102"/>
   <xsl:template match="/cda:ClinicalDocument" priority="3999" mode="M103">
      <xsl:choose>
         <xsl:when
            test="not(cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC1464'] or cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235']) or ((cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC1464'] or cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235']) and //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.5'])"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">fatals</xsl:attribute>
                  <xsl:element name="assertionID">Fatal-002</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Fatal: A manually or alternately initiated eICR must
                     contain at least one Initial Case Report Initiation Reason Observation. (Rule:
                     validate_trigger_presence)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(cda:documentationOf/cda:serviceEvent/cda:code[@code =
                     'PHC1464'] or cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235'])
                     or ((cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC1464'] or
                     cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235']) and
                     //cda:observation/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.5'])</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(//cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.5']) or (cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC1464'] and //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.5']) or (cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235'] and //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.5'])"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">fatals</xsl:attribute>
                  <xsl:element name="assertionID">Fatal-003</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Fatal: If the "Initial Case Report Initiation Reason"
                     template is present then this must be either a manually or alternately
                     initiated eICR and documentationOf/serviceEvent must be present with code
                     PHC1464: "Manually Initiated eICR" or code PHC2235 "Alternately Initated eICR"
                     (Rule: validate_trigger_presence)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(//cda:observation/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.5']) or
                     (cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC1464'] and
                     //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.5'])
                     or (cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235'] and
                     //cda:observation/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.5'])</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="(cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC1464'] or cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235']) or ((not(cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC1464']) and not(cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235'])) and (//cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.4'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.3'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.2'] or //cda:organizer/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.35'] or //cda:manufacturedProduct/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.36'] or //cda:substanceAdministration/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.38'] or //cda:act/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.41'] or //cda:procedure/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.42'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.43'] or //cda:procedure/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.44'] or //cda:act/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.45'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.46']))"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">fatals</xsl:attribute>
                  <xsl:element name="assertionID">Fatal-004</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Fatal: An automatically initiated eICR SHALL contain
                     at least one of Initial Case Report Trigger Code Lab Test Order, Initial Case
                     Report Trigger Code Problem Observation, Initial Case Report Trigger Code
                     Result Observation, Initial Case Report Trigger Code Medication Information,
                     Initial Case Report Trigger Code Result Organizer, Initial Case Report Trigger
                     Code Immunization Medication Information, Initial Case Report Trigger Code
                     Planned Act, Initial Case Report Trigger Code Planned Observation, Initial Case
                     Report Trigger Code Planned Procedure, Initial Case Report Trigger Code
                     Procedure Activity Act, Initial Case Report Trigger Code Procedure Activity
                     Observation, or Initial Case Report Trigger Code Procedure Activity Procedure.
                     (Rule: validate_trigger_presence)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">(cda:documentationOf/cda:serviceEvent/cda:code[@code =
                     'PHC1464'] or cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235'])
                     or ((not(cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC1464']) and
                     not(cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235'])) and
                     (//cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.4']
                     or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.3']
                     or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.2']
                     or //cda:organizer/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.35']
                     or //cda:manufacturedProduct/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.36'] or
                     //cda:substanceAdministration/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.38'] or //cda:act/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.41'] or //cda:procedure/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.42'] or //cda:observation/cda:templateId[@root
                     = '2.16.840.1.113883.10.20.15.2.3.43'] or //cda:procedure/cda:templateId[@root
                     = '2.16.840.1.113883.10.20.15.2.3.44'] or //cda:act/cda:templateId[@root =
                     '2.16.840.1.113883.10.20.15.2.3.45'] or //cda:observation/cda:templateId[@root
                     = '2.16.840.1.113883.10.20.15.2.3.46']))</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M103"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M103"/>
   <xsl:template match="/cda:ClinicalDocument" priority="3999" mode="M104">
      <xsl:choose>
         <xsl:when
            test="//cda:patientRole/cda:addr/cda:state[text()][not(@nullFlavor)] or //cda:patientRole/cda:addr/cda:postalCode[text()][not(@nullFlavor)] or //cda:healthCareFacility/cda:location/cda:addr/cda:state[text()][not(@nullFlavor)] or //cda:healthCareFacility/cda:location/cda:addr/cda:postalCode[text()][not(@nullFlavor)] or //cda:author/cda:assignedAuthor/cda:addr/cda:postalCode[text()][not(@nullFlavor)] or //cda:author/cda:assignedAuthor/cda:addr/cda:state[text()][not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">fatals</xsl:attribute>
                  <xsl:element name="assertionID">Fatal-006</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Fatal Error (Missing all Patient and Facility State
                     and Zip): An eICR must contain at least one of (non-nullFlavor) Patient State
                     or Patient Zip or Facility State or Facility Zip or Author State or Author Zip
                     (Rule: validate_patient_provider_author state_zip)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >//cda:patientRole/cda:addr/cda:state[text()][not(@nullFlavor)] or
                     //cda:patientRole/cda:addr/cda:postalCode[text()][not(@nullFlavor)] or
                     //cda:healthCareFacility/cda:location/cda:addr/cda:state[text()][not(@nullFlavor)]
                     or
                     //cda:healthCareFacility/cda:location/cda:addr/cda:postalCode[text()][not(@nullFlavor)]
                     or
                     //cda:author/cda:assignedAuthor/cda:addr/cda:postalCode[text()][not(@nullFlavor)]
                     or
                     //cda:author/cda:assignedAuthor/cda:addr/cda:state[text()][not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M104"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M104"/>
   <xsl:template match="/cda:ClinicalDocument" priority="3999" mode="M107">
      <xsl:choose>
         <xsl:when test="count(cda:id/@root) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">fatals</xsl:attribute>
                  <xsl:element name="assertionID">Fatal-007</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Fatal (Missing eICR id): An eICR SHALL contain exactly
                     one [1..1] id and must have at least a root. Rule: (validate_id)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:id/@root) = 1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(cda:id/@nullFlavor) = 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">fatals</xsl:attribute>
                  <xsl:element name="assertionID">Fatal-008</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Fatal (eICR id contains nullFlavor): An eICR id SHALL
                     NOT contain nullFlavor. Rule: (validate_id)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:id/@nullFlavor) = 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(cda:id[@root = '']) = 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">fatals</xsl:attribute>
                  <xsl:element name="assertionID">Fatal-009</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Fatal (eICR id/root is empty): An eICR id SHALL NOT
                     contain an empty id/root. Rule: (validate_id)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:id[@root = '']) = 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(cda:id[@extension = '']) = 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">fatals</xsl:attribute>
                  <xsl:element name="assertionID">Fatal-010</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Fatal (eICR id/extension is empty): An eICR id SHALL
                     NOT contain an empty id/extension. Rule: (validate_id)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:id[@extension = '']) = 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M107"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M107"/>
   <xsl:template match="/cda:ClinicalDocument" priority="3999" mode="M108">
      <xsl:choose>
         <xsl:when test="count(cda:componentOf/cda:encompassingEncounter) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">fatals</xsl:attribute>
                  <xsl:element name="assertionID">Fatal-011</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Fatal: SHALL contain exactly one [1..1]
                     ClinicalDocument/componentOf/encompassingEncounter</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:componentOf/cda:encompassingEncounter) =
                     1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M108"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M108"/>
   <xsl:template match="/cda:ClinicalDocument" priority="3999" mode="M105">
      <xsl:choose>
         <xsl:when test="cda:effectiveTime[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">severe-warnings</xsl:attribute>
                  <xsl:element name="assertionID">Severe-Warning-001</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Severe Warning (Report Date/Time):
                     ClinicalDocument/effectiveTime SHALL NOT contain [0..0]
                     @nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> cda:effectiveTime[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="string-length(cda:effectiveTime/@value) &gt;= 8"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">severe-warnings</xsl:attribute>
                  <xsl:element name="assertionID">Severe-Warning-002</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Severe Warning (Report Date/Time):
                     ClinicalDocument/effectiveTime SHALL contain at least yyyymmdd.</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> string-length(cda:effectiveTime/@value) &gt;=
                     8</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:effectiveTime/@value) or not(string-length(cda:effectiveTime/@value) &gt;= 8) or matches(normalize-space(cda:effectiveTime/@value), '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$')"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">severe-warnings</xsl:attribute>
                  <xsl:element name="assertionID">Severe-Warning-002a</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Severe Warning: (Report Date/Time):
                     ClinicalDocument/effectiveTime @value attribute is not in valid CDA TS format
                     (YYYY[MM[DD[HH[MM[SS[.s+]]]]]][±HHMM])</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:effectiveTime/@value) or
                     not(string-length(cda:effectiveTime/@value) &gt;= 8) or
                     matches(normalize-space(cda:effectiveTime/@value),
                     '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$')</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M105"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M105"/>
   <xsl:template match="/cda:ClinicalDocument" priority="3999" mode="M106">
      <xsl:choose>
         <xsl:when
            test="cda:componentOf/cda:encompassingEncounter/cda:location/cda:healthCareFacility/cda:location/cda:addr[cda:postalCode[text()]][not(cda:postalCode/@nullFlavor)][cda:state[text()]][not(cda:state/@nullFlavor)] or cda:author/cda:assignedAuthor/cda:representedOrganization/cda:addr[cda:postalCode[text()]][not(cda:postalCode/@nullFlavor)][cda:state[text()]][not(cda:state/@nullFlavor)] or cda:author/cda:assignedAuthor/cda:addr[cda:postalCode[text()]][not(cda:postalCode/@nullFlavor)][cda:state[text()]][not(cda:state/@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">severe-warnings</xsl:attribute>
                  <xsl:element name="assertionID">Severe-Warning-003</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Severe Warning (Missing Facility Address): An eICR
                     SHALL contain an
                     encompassingEncounter/location/healthCareFacility/location/addr, an
                     author/assignedAuthor/representedOrganization/addr, or an
                     author/assignedAuthor/addr and this addr SHALL contain both a non-empty,
                     non-null state and a non-empty, non-null zip</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >cda:componentOf/cda:encompassingEncounter/cda:location/cda:healthCareFacility/cda:location/cda:addr[cda:postalCode[text()]][not(cda:postalCode/@nullFlavor)][cda:state[text()]][not(cda:state/@nullFlavor)]
                     or
                     cda:author/cda:assignedAuthor/cda:representedOrganization/cda:addr[cda:postalCode[text()]][not(cda:postalCode/@nullFlavor)][cda:state[text()]][not(cda:state/@nullFlavor)]
                     or
                     cda:author/cda:assignedAuthor/cda:addr[cda:postalCode[text()]][not(cda:postalCode/@nullFlavor)][cda:state[text()]][not(cda:state/@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M106"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M106"/>
   <xsl:template match="/cda:ClinicalDocument" priority="3999" mode="M109">
      <xsl:choose>
         <xsl:when test="count(cda:recordTarget/cda:patientRole/cda:id) &gt; 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">severe-warnings</xsl:attribute>
                  <xsl:element name="assertionID">Severe-Warning-004</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Severe Warning (Patient Id exists): SHALL contain at
                     least one [1..*] ClinicalDocument/recordTarget/patientRole/id</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:recordTarget/cda:patientRole/cda:id) &gt;
                     0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(cda:recordTarget/cda:patientRole/cda:id[@nullFlavor]) = 0"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">severe-warnings</xsl:attribute>
                  <xsl:element name="assertionID">Severe-Warning-005</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Severe Warning (Patient Id nullFlavor):
                     ClinicalDocument/recordTarget/patientRole/id SHALL NOT contain
                     nullFlavor</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >count(cda:recordTarget/cda:patientRole/cda:id[@nullFlavor]) = 0</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M109"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M109"/>
   <xsl:template
      match="//cda:code | cda:value[@xsi:type = 'CD'] | cda:value[@xsi:type = 'CE'] | cda:administrationUnitCode | cda:administrativeGenderCode | cda:awarenessCode | cda:confidentialityCode | cda:dischargeDispositionCode | cda:ethnicGroupCode | cda:functionCode | cda:interpretationCode | cda:maritalStatusCode | cda:methodCode | cda:modeCode | cda:priorityCode | cda:proficiencyLevelCode | cda:RaceCode | cda:religiousAffiliationCode | cda:routeCode | cda:standardIndustryClassCode"
      priority="3999" mode="M100">
      <xsl:choose>
         <xsl:when
            test="(parent::cda:regionOfInterest) or ((@code or @nullFlavor or (@codeSystem and @nullFlavor = 'OTH')) and not(@code and @nullFlavor) and not(@codeSystem and @nullFlavor != 'OTH'))"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-validate_CD_CE-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data types of CD or CE SHALL have either @code or
                     @nullFlavor or both (@codeSystem and @nullFlavor="OTH") but SHALL NOT have both
                     @code and @nullFlavor and SHALL NOT have @codeSystem and @nullFlavor not equal
                     to "OTH" (Rule: validate_CD_CE)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">(parent::cda:regionOfInterest) or ((@code or @nullFlavor
                     or (@codeSystem and @nullFlavor = 'OTH')) and not(@code and @nullFlavor) and
                     not(@codeSystem and @nullFlavor != 'OTH'))</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M100"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M100"/>
   <xsl:template
      match="//cda:code | cda:value[@xsi:type = 'CD'] | cda:value[@xsi:type = 'CE'] | cda:administrationUnitCode | cda:administrativeGenderCode | cda:awarenessCode | cda:confidentialityCode | cda:dischargeDispositionCode | cda:ethnicGroupCode | cda:functionCode | cda:interpretationCode | cda:maritalStatusCode | cda:methodCode | cda:modeCode | cda:priorityCode | cda:proficiencyLevelCode | cda:raceCode | cda:religiousAffiliationCode | cda:routeCode | cda:standardIndustryClassCode"
      priority="3999" mode="M101">
      <xsl:choose>
         <xsl:when test="(parent::cda:regionOfInterest) or ((@code and @codeSystem) or not(@code))"/>
