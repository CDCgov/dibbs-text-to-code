                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(cda:componentOf/cda:encompassingEncounter) or
                     cda:componentOf/cda:encompassingEncounter[count(cda:id) &gt; 0]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
