viderOrganization/cda:addr | cda:ClinicalDocument[cda:templateId[@root = '2.16.840.1.113883.10.20.15.2' and @extension = '2022-05-01']]/cda:recordTarget/cda:patientRole/cda:patient/cda:guardian/cda:addr | cda:ClinicalDocument[cda:templateId[@root = '2.16.840.1.113883.10.20.15.2' and @extension = '2022-05-01']]/cda:recordTarget/cda:patientRole/cda:addr | cda:ClinicalDocument[cda:templateId[@root = '2.16.840.1.113883.10.20.15.2' and @extension = '2022-05-01']]/cda:participant/cda:associatedEntity/cda:addr | cda:ClinicalDocument[cda:templateId[@root = '2.16.840.1.113883.10.20.15.2' and @extension = '2022-05-01']]/cda:participant/cda:associatedEntity/cda:scopingOrganization/cda:addr"
      priority="3999" mode="M114">
      <xsl:choose>
         <xsl:when
            test="@nullFlavor or (count(cda:streetAddressLine) &gt;= 1 and count(cda:streetAddressLine) &lt;= 4)"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-81-7291-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain at least one and not more than 4
                     streetAddressLine (CONF:81-7291).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">@nullFlavor or (count(cda:streetAddressLine) &gt;= 1 and
                     count(cda:streetAddressLine) &lt;= 4)</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(cda:city) = 1 or @nullFlavor"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-81-7292-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] city
                     (CONF:81-7292).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:city)=1 or @nullFlavor</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="not(text()[normalize-space()])"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-81-7296-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">**SHALL NOT** have mixed content except for white
                     space (CONF:81-7296).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(text()[normalize-space()])</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="@nullFlavor or (cda:country = 'US' and cda:state) or (cda:country != 'US') or (not(cda:country) and cda:state)"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-81-10024-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">If the country is US, the state element is required
                     but SHOULD have @nullFlavor if the state is unknown. If country is not
                     specified, it's assumed to be US. If country is something other than US, the
                     state MAY be present but MAY be bound to different vocabularies
                     (CONF:81-10024).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">@nullFlavor or (cda:country='US' and cda:state) or
                     (cda:country!='US') or (not(cda:country) and cda:state) </xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="@nullFlavor or (cda:country = 'US' and cda:postalCode) or (cda:country != 'US') or (not(cda:country) and cda:postalCode)"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-81-10025-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">If the country is US, the postalCode element is
                     required but SHOULD have @nullFlavor if the postalCode is unknown. If country
                     is not specified, it's assumed to be US. If country is something other than US,
                     the postalCode MAY be present but MAY be bound to different vocabularies
                     (CONF:81-10025).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">@nullFlavor or (cda:country='US' and cda:postalCode) or
                     (cda:country!='US') or (not(cda:country) and cda:postalCode)</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M114"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M114"/>
   <xsl:template
      match="cda:participantRole[cda:templateId[@root = '2.16.840.1.113883.10.20.22.4.24']]"
      priority="3999" mode="M115">
      <xsl:choose>
         <xsl:when test="@classCode = 'MANU'"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-81-7490</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] @classCode="MANU"
                     (CodeSystem: HL7RoleClass urn:oid:2.16.840.1.113883.5.110 STATIC)
                     (CONF:81-7490).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">@classCode='MANU'</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(cda:playingEntity) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-81-7492</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] playingEntity
                     (CONF:81-7492).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:playingEntity)=1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="cda:playingEntity[count(cda:code) = 1]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-81-7493</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This playingEntity SHALL contain exactly one [1..1]
                     code (CONF:81-7493).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">cda:playingEntity[count(cda:code)=1]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(cda:code) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-81-19137</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] code
                     (CONF:81-19137).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:code)=1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="cda:code[@code = '412307009']"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
