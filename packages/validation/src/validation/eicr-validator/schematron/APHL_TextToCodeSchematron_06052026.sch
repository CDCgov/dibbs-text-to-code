                     translation/@sdtc:valueSet and translation/@sdtc:valueSetVersion **SHALL** be
                     present (CONF:4482-535).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">(cda:value/cda:translation/@sdtc:valueSet and
                     cda:value/cda:translation/@sdtc:valueSetVersion) or
                     (not(cda:value/cda:translation/@sdtc:valueSet) and
                     not(cda:value/cda:translation/@sdtc:valueSetVersion))</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="(cda:value/@sdtc:valueSet and cda:value/@sdtc:valueSetVersion) or (not(cda:value/@sdtc:valueSet) and not(cda:value/@sdtc:valueSetVersion))"/>
         <xsl:otherwise>
