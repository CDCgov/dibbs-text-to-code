                     0]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="cda:recordTarget/cda:patientRole[count(cda:id) &gt; 0]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-146</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This patientRole SHALL contain at least one [1..*] id
                     (CONF:4527-146).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">cda:recordTarget/cda:patientRole[count(cda:id) &gt;
                     0]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="cda:author/cda:time[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-144</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This time SHALL NOT contain [0..0] @nullFlavor
                     (CONF:4527-144).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">cda:author/cda:time[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="cda:author[count(cda:assignedAuthor) = 1] and ((cda:componentOf/cda:encompassingEncounter/cda:code[@code = 'PHC2237'] and cda:author/cda:assignedAuthor/cda:assignedPerson and cda:author/cda:assignedAuthor/cda:representedOrganization) or not(cda:componentOf/cda:encompassingEncounter/cda:code[@code = 'PHC2237']))"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-599-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Where a trigger occurs outside of an encounter
                     (encompassingEncounter/code = PHC2237) both author/assignedAuthor/authorPerson
                     and author/assignedAuthor/representedOrganization SHALL be present
                     (CONF:4527-599).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">cda:author[count(cda:assignedAuthor)=1] and
                     ((cda:componentOf/cda:encompassingEncounter/cda:code[@code='PHC2237'] and
                     cda:author/cda:assignedAuthor/cda:assignedPerson and
                     cda:author/cda:assignedAuthor/cda:representedOrganization) or
                     not(cda:componentOf/cda:encompassingEncounter/cda:code[@code='PHC2237']))</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:author/cda:assignedAuthor/cda:assignedPerson) or cda:author/cda:assignedAuthor/cda:assignedPerson[count(cda:name) &gt; 0]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-1132</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">The assignedPerson, if present, SHALL contain at least
                     one [1..*] name (CONF:4527-1132).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(cda:author/cda:assignedAuthor/cda:assignedPerson) or
                     cda:author/cda:assignedAuthor/cda:assignedPerson[count(cda:name) &gt;
                     0]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:author/cda:assignedAuthor/cda:representedOrganization) or cda:author/cda:assignedAuthor/cda:representedOrganization[count(cda:addr) = 1]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-1133</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">The representedOrganization, if present, SHALL contain
                     exactly one [1..1] addr (CONF:4527-1133).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >not(cda:author/cda:assignedAuthor/cda:representedOrganization) or
                     cda:author/cda:assignedAuthor/cda:representedOrganization[count(cda:addr)=1]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="cda:effectiveTime[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-143</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This effectiveTime SHALL NOT contain [0..0]
                     @nullFlavor (CONF:4527-143).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">cda:effectiveTime[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:documentationOf/cda:serviceEvent) or cda:documentationOf/cda:serviceEvent[count(cda:code) = 1]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-398</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This serviceEvent SHALL contain exactly one [1..1]
                     code, which SHOULD be selected from ValueSet eICR Initiation
                     urn:oid:2.16.840.1.113883.10.20.15.2.5.11 DYNAMIC
                     (CONF:4527-398).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(cda:documentationOf/cda:serviceEvent) or
                     cda:documentationOf/cda:serviceEvent[count(cda:code)=1]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:relatedDocument/cda:parentDocument) or cda:relatedDocument/cda:parentDocument[count(cda:setId) = 1]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-460</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">This parentDocument SHALL contain exactly one [1..1]
                     setId (CONF:4527-460).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(cda:relatedDocument/cda:parentDocument) or
                     cda:relatedDocument/cda:parentDocument[count(cda:setId)=1]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:relatedDocument/cda:parentDocument) or cda:relatedDocument/cda:parentDocument[count(cda:versionNumber) = 1]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-461</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">This parentDocument SHALL contain exactly one [1..1]
                     versionNumber (CONF:4527-461).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(cda:relatedDocument/cda:parentDocument) or
                     cda:relatedDocument/cda:parentDocument[count(cda:versionNumber)=1]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="count(cda:code[@code = '55751-2'][@codeSystem = '2.16.840.1.113883.6.1' or @nullFlavor]) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-107</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] code="55751-2" Public
                     Health Case report (CodeSystem: LOINC urn:oid:2.16.840.1.113883.6.1)
                     (CONF:4527-107).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >count(cda:code[@code='55751-2'][@codeSystem='2.16.840.1.113883.6.1' or
                     @nullFlavor])=1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(cda:title[text() = 'Initial Public Health Case Report']) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-109</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] title="Initial Public
                     Health Case Report" (CONF:4527-109).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:title[text()='Initial Public Health Case
                     Report'])=1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(cda:setId) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-458</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">SHALL contain exactly one [1..1] setId
                     (CONF:4527-458).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:setId)=1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="count(cda:versionNumber) = 1"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-459</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">SHALL contain exactly one [1..1] versionNumber
                     (CONF:4527-459).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">count(cda:versionNumber)=1</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="((cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC1464'] or cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235']) and //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.5']) or (not(cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC1464']) and not(cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235']))"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-596-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">A manually/alternately initiated eICR SHALL contain at
                     least one Initial Case Report Initiation Reason Observation
                     (CONF:4527-596).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">((cda:documentationOf/cda:serviceEvent/cda:code[
                     @code='PHC1464'] or cda:documentationOf/cda:serviceEvent/cda:code[
                     @code='PHC2235']) and //cda:observation/cda:templateId[
                     @root='2.16.840.1.113883.10.20.15.2.3.5']) or
                     (not(cda:documentationOf/cda:serviceEvent/cda:code[ @code='PHC1464']) and
                     not(cda:documentationOf/cda:serviceEvent/cda:code[
                     @code='PHC2235']))</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(//cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.5']) or ((cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC1464'] or cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235']) and //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.5'])"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-597-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">If the "Initial Case Report Initiation Reason"
                     template is present then this SHALL be a manually/alternately initiated eICR
                     and documentationOf/serviceEvent SHALL be present with code PHC1464: "Manually
                     Initiated eICR or code PHC2235: "Alternately Initiated eICR"
                     (CONF:4527-597).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not( //cda:observation/cda:templateId[
                     @root='2.16.840.1.113883.10.20.15.2.3.5']) or
                     ((cda:documentationOf/cda:serviceEvent/cda:code[ @code='PHC1464'] or
                     cda:documentationOf/cda:serviceEvent/cda:code[ @code='PHC2235']) and
                     //cda:observation/cda:templateId[@root='2.16.840.1.113883.10.20.15.2.3.5'])</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="(cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC1464'] or cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235']) or ((not(cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC1464']) and not(cda:documentationOf/cda:serviceEvent/cda:code[@code = 'PHC2235'])) and (//cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.4'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.3'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.2'] or //cda:organizer/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.35'] or //cda:manufacturedProduct/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.36'] or //cda:manufacturedProduct/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.38'] or //cda:act/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.41'] or //cda:procedure/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.42'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.43'] or //cda:procedure/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.44'] or //cda:act/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.45'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.46']))"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-598-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">An automatically initiated eICR SHALL contain at least
                     one of Initial Case Report Trigger Code Lab Test Order, Initial Case Report
                     Trigger Code Problem Observation, Initial Case Report Trigger Code Result
                     Observation, Initial Case Report Trigger Code Medication Information, Initial
                     Case Report Trigger Code Result Organizer, Initial Case Report Trigger Code
                     Immunization Medication Information, Initial Case Report Trigger Code Planned
                     Act, Initial Case Report Trigger Code Planned Observation, Initial Case Report
                     Trigger Code Planned Procedure, Initial Case Report Trigger Code Procedure
                     Activity Act, Initial Case Report Trigger Code Procedure Activity Observation,
                     or Initial Case Report Trigger Code Procedure Activity Procedure
                     (CONF:4527-598).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">(cda:documentationOf/cda:serviceEvent/cda:code[
                     @code='PHC1464'] or cda:documentationOf/cda:serviceEvent/cda:code[
                     @code='PHC2235']) or ((not(cda:documentationOf/cda:serviceEvent/cda:code[
                     @code='PHC1464']) and not(cda:documentationOf/cda:serviceEvent/cda:code[
                     @code='PHC2235'])) and (//cda:observation/cda:templateId[
                     @root='2.16.840.1.113883.10.20.15.2.3.4'] or
                     //cda:observation/cda:templateId[@root='2.16.840.1.113883.10.20.15.2.3.3'] or
                     //cda:observation/cda:templateId[@root='2.16.840.1.113883.10.20.15.2.3.2'] or
                     //cda:organizer/cda:templateId[@root='2.16.840.1.113883.10.20.15.2.3.35'] or
                     //cda:manufacturedProduct/cda:templateId[@root='2.16.840.1.113883.10.20.15.2.3.36']
                     or
                     //cda:manufacturedProduct/cda:templateId[@root='2.16.840.1.113883.10.20.15.2.3.38']
                     or //cda:act/cda:templateId[@root='2.16.840.1.113883.10.20.15.2.3.41'] or
                     //cda:procedure/cda:templateId[@root='2.16.840.1.113883.10.20.15.2.3.42'] or
                     //cda:observation/cda:templateId[@root='2.16.840.1.113883.10.20.15.2.3.43'] or
                     //cda:procedure/cda:templateId[@root='2.16.840.1.113883.10.20.15.2.3.44'] or
                     //cda:act/cda:templateId[@root='2.16.840.1.113883.10.20.15.2.3.45'] or
                     //cda:observation/cda:templateId[@root='2.16.840.1.113883.10.20.15.2.3.46']))</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:participant[@typeCode = 'LOC']/cda:associatedEntity/cda:id) or cda:participant[@typeCode = 'LOC']/cda:associatedEntity/cda:id[@root]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-1049-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Such ids SHALL contain exactly one [1..1] @root
                     (CONF:4527-1049).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >not(cda:participant[@typeCode='LOC']/cda:associatedEntity/cda:id) or
                     cda:participant[@typeCode='LOC']/cda:associatedEntity/cda:id[@root]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:participant[@typeCode = 'LOC']/cda:associatedEntity/cda:code) or cda:participant[@typeCode = 'LOC']/cda:associatedEntity/cda:code[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-1051-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This code SHALL NOT contain [0..0] @nullFlavor
                     (CONF:4527-1051).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >not(cda:participant[@typeCode='LOC']/cda:associatedEntity/cda:code) or
                     cda:participant[@typeCode='LOC']/cda:associatedEntity/cda:code[not(@nullFlavor)]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:participant[@typeCode = 'LOC']/cda:associatedEntity/cda:scopingOrganization) or cda:participant[@typeCode = 'LOC']/cda:associatedEntity/cda:scopingOrganization[count(cda:name) = 1]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-1052-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This scopingOrganization SHALL contain exactly one
                     [1..1] name (CONF:4527-1052).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >not(cda:participant[@typeCode='LOC']/cda:associatedEntity/cda:scopingOrganization)
                     or
                     cda:participant[@typeCode='LOC']/cda:associatedEntity/cda:scopingOrganization[count(cda:name)=1]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:participant[@typeCode = 'LOC']/cda:associatedEntity/cda:scopingOrganization) or cda:participant[@typeCode = 'LOC']/cda:associatedEntity/cda:scopingOrganization[count(cda:telecom) &gt; 0]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-1053-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This scopingOrganization SHALL contain at least one
                     [1..*] telecom (CONF:4527-1053).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >not(cda:participant[@typeCode='LOC']/cda:associatedEntity/cda:scopingOrganization)
                     or
                     cda:participant[@typeCode='LOC']/cda:associatedEntity/cda:scopingOrganization[count(cda:telecom)
                     &gt; 0]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:author/cda:assignedAuthor/cda:representedOrganization) or cda:author/cda:assignedAuthor/cda:representedOrganization[count(cda:id) &gt; 0]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-1138</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">The representedOrganization, if present, SHALL contain
                     at least one [1..*] id (CONF:4527-1138).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >not(cda:author/cda:assignedAuthor/cda:representedOrganization) or
                     cda:author/cda:assignedAuthor/cda:representedOrganization[count(cda:id) &gt;
                     0]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:author/cda:assignedAuthor/cda:representedOrganization/cda:id) or cda:author/cda:assignedAuthor/cda:representedOrganization/cda:id[@root]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-1139</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Such ids SHALL contain exactly one [1..1] @root
                     (CONF:4527-1139).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >not(cda:author/cda:assignedAuthor/cda:representedOrganization/cda:id) or
                     cda:author/cda:assignedAuthor/cda:representedOrganization/cda:id[@root]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="cda:author/cda:assignedAuthor[count(cda:id) &gt; 0]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-1141</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This assignedAuthor SHALL contain at least one [1..*]
                     id (CONF:4527-1141).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">cda:author/cda:assignedAuthor[count(cda:id) &gt;
                     0]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="cda:author/cda:assignedAuthor[count(cda:addr) &gt; 0]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-1142</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This assignedAuthor SHALL contain at least one [1..*]
                     addr (CONF:4527-1142).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">cda:author/cda:assignedAuthor[count(cda:addr) &gt;
                     0]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="cda:author/cda:assignedAuthor[count(cda:telecom) &gt; 0]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-1143</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This assignedAuthor SHALL contain at least one [1..*]
                     telecom (CONF:4527-1143).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">cda:author/cda:assignedAuthor[count(cda:telecom) &gt;
                     0]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="cda:author[count(cda:assignedAuthor) = 1] and ((cda:componentOf/cda:encompassingEncounter/cda:code[@code = 'PHC2237'] and cda:author/cda:assignedAuthor/cda:assignedPerson and cda:author/cda:assignedAuthor/cda:representedOrganization) or not(cda:componentOf/cda:encompassingEncounter/cda:code[@code = 'PHC2237']))"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-1144-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Where a trigger occurs outside of an encounter the
                     author/assignedAuthor/authorPerson and
                     author/assignedAuthor/representedOrganization **SHALL** be present
                     (CONF:4527-1144).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">cda:author[count(cda:assignedAuthor)=1] and
                     ((cda:componentOf/cda:encompassingEncounter/cda:code[@code='PHC2237'] and
                     cda:author/cda:assignedAuthor/cda:assignedPerson and
                     cda:author/cda:assignedAuthor/cda:representedOrganization) or
                     not(cda:componentOf/cda:encompassingEncounter/cda:code[@code='PHC2237']))</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="cda:componentOf/cda:encompassingEncounter/cda:code[@code = 'PHC2237'] or cda:componentOf/cda:encompassingEncounter/cda:location/cda:healthCareFacility/cda:location[count(cda:addr/cda:state[text()]) = 1]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-405-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This addr/state SHALL be present and SHALL NOT be
                     empty (CONF:4527-405).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >cda:componentOf/cda:encompassingEncounter/cda:code[@code='PHC2237'] or
                     cda:componentOf/cda:encompassingEncounter/cda:location/cda:healthCareFacility/cda:location[count(cda:addr/cda:state[text()])=1]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="cda:componentOf/cda:encompassingEncounter/cda:code[@code = 'PHC2237'] or cda:componentOf/cda:encompassingEncounter/cda:location/cda:healthCareFacility/cda:location[count(cda:addr/cda:city[text()]) = 1]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-406-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This addr/city SHALL NOT be empty
                     (CONF:4527-406).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >cda:componentOf/cda:encompassingEncounter/cda:code[@code='PHC2237'] or
                     cda:componentOf/cda:encompassingEncounter/cda:location/cda:healthCareFacility/cda:location[count(cda:addr/cda:city[text()])=1]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="cda:componentOf/cda:encompassingEncounter/cda:code[@code = 'PHC2237'] or cda:componentOf/cda:encompassingEncounter/cda:location/cda:healthCareFacility/cda:location[count(cda:addr/cda:streetAddressLine[text()]) &gt; 0]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-407-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This addr/streetAddressLine SHALL NOT be empty
                     (CONF:4527-407).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >cda:componentOf/cda:encompassingEncounter/cda:code[@code='PHC2237'] or
                     cda:componentOf/cda:encompassingEncounter/cda:location/cda:healthCareFacility/cda:location[count(cda:addr/cda:streetAddressLine[text()])&gt;0]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="cda:componentOf/cda:encompassingEncounter/cda:code[@code = 'PHC2237'] or cda:componentOf/cda:encompassingEncounter/cda:location/cda:healthCareFacility/cda:location[count(cda:addr/cda:postalCode[text()]) = 1]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-408-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">This addr/postalCode SHALL be present and SHALL NOT be
                     empty (CONF:4527-408).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
                     >cda:componentOf/cda:encompassingEncounter/cda:code[@code='PHC2237'] or
                     cda:componentOf/cda:encompassingEncounter/cda:location/cda:healthCareFacility/cda:location[count(cda:addr/cda:postalCode[text()])=1]</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M294"/>
   </xsl:template>
   <xsl:template
      match="cda:ClinicalDocument[cda:templateId[@root = '2.16.840.1.113883.10.20.15.2' and @extension = '2022-05-01']]/cda:component/cda:structuredBody/cda:component[cda:section]/cda:entry[cda:observation]"
      priority="3997" mode="M294">
      <xsl:choose>
         <xsl:when test="not(tested)"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-327-branch-326-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] Birth Sex Observation
                     (identifier: urn:hl7ii:2.16.840.1.113883.10.20.22.4.200:2016-06-01)
                     (CONF:4527-327).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(tested)</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M294"/>
   </xsl:template>
   <xsl:template
      match="cda:ClinicalDocument[cda:templateId[@root = '2.16.840.1.113883.10.20.15.2' and @extension = '2022-05-01']]/cda:component/cda:structuredBody/cda:component[cda:section]/cda:entry[cda:act]"
      priority="3995" mode="M294">
      <xsl:choose>
         <xsl:when test="not(tested)"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4527-335-branch-334-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] Travel History (V3)
                     (identifier: urn:hl7ii:2.16.840.1.113883.10.20.15.2.3.1:2022-05-01)
                     (CONF:4527-335).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">not(tested)</xsl:element>
                  <xsl:element name="specification"/>
