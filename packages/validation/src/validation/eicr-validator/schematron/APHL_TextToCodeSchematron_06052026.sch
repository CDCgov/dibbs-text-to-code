               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-14840</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">The performer, if present, SHALL contain exactly one
                     [1..1] @typeCode, which SHALL be selected from ValueSet x_ServiceEventPerformer
                     urn:oid:2.16.840.1.113883.1.11.19601 STATIC (CONF:1198-14840).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
