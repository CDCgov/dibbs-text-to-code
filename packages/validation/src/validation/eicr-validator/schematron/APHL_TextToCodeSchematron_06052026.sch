                  <xsl:element name="assertionID">dq-encounter_effectiveTime-002</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Encounter effectiveTime data element
                     @value attribute is not at least 8 characters (yyyymmdd)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:effectiveTime) or cda:effectiveTime[@nullFlavor]
                     or not(cda:effectiveTime[@value]) or string-length(cda:effectiveTime/@value)
                     &gt;= 8</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when
            test="not(cda:effectiveTime) or cda:effectiveTime[@nullFlavor] or not(cda:effectiveTime/@value) or matches(normalize-space(cda:effectiveTime/@value), '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$')"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-encounter_effectiveTime-002a</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data Quality: Encounter effectiveTime data element
                     @value attribute is not in valid CDA TS format
                     (YYYY[MM[DD[HH[MM[SS[.s+]]]]]][±HHMM])</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"> not(cda:effectiveTime) or cda:effectiveTime[@nullFlavor]
                     or not(cda:effectiveTime/@value) or
                     matches(normalize-space(cda:effectiveTime/@value),
                     '^\d{4}(\d{2}(\d{2}(\d{2}(\d{2}(\d{2}(\.\d+)?)?)?)?)?)?([+-]\d{4})?$')</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:choose>
         <xsl:when test="(cda:effectiveTime/@value) or cda:effectiveTime/cda:low[not(@nullFlavor)]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">data_quality</xsl:attribute>
                  <xsl:element name="assertionID">dq-encounter_effectiveTime-004</xsl:element>
                  <xsl:element name="flag">cste</xsl:element>
                  <xsl:element name="message">Data Quality: Encounter effectiveTime low data element
