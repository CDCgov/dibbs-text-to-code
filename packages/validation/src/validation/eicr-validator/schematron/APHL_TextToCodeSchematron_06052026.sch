            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-validate_code_codesystem_CD_CE-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Data types of CD or CE SHALL NOT have @code without
                     @codeSystem (Rule: validate_code_codesystem_CD_CE)</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">(parent::cda:regionOfInterest) or ((@code and
                     @codeSystem) or not(@code))</xsl:element>
                  <xsl:element name="specification"/>
               </xsl:element>
            </xsl:element>
         </xsl:otherwise>
      </xsl:choose>
      <xsl:apply-templates mode="M101"/>
   </xsl:template>
   <xsl:template match="text()" priority="-1" mode="M101"/>
