      <xsl:choose>
         <xsl:when
            test="cda:value[@xsi:type = 'CD'][@code and @sdtc:valueSetVersion and @sdtc:valueSet] or cda:value[@xsi:type = 'CD']/cda:translation[@code and @sdtc:valueSetVersion and @sdtc:valueSet]"/>
         <xsl:otherwise>
            <xsl:element name="validationResult">
               <xsl:element name="issue">
                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-4482-1149-c</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">Either cda:value[@xsi:type='CD'][@code and
                     @sdtc:valueSetVersion and @sdtc:valueSet] or
                     cda:value[@xsi:type='CD']/cda:translation[@code and @sdtc:valueSetVersion and
                     @sdtc:valueSet] **SHALL** be present (CONF:4482-1149).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test">cda:value[@xsi:type='CD'][@code and @sdtc:valueSetVersion
