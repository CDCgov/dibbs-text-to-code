                  <xsl:attribute name="severity">errors</xsl:attribute>
                  <xsl:element name="assertionID">a-1198-8712</xsl:element>
                  <xsl:element name="flag"/>
                  <xsl:element name="message">SHALL contain exactly one [1..1] templateId
                     (CONF:1198-8712) such that it SHALL contain exactly one [1..1]
                     @root="2.16.840.1.113883.10.20.22.4.49" (CONF:1198-26353). SHALL contain
                     exactly one [1..1] @extension="2015-08-01" (CONF:1198-32546).</xsl:element>
                  <xsl:element name="context">
                     <xsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </xsl:element>
                  <xsl:element name="test"
