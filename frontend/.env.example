# Copy to .env and fill in (.env is gitignored). Used by ./demo.sh.

# OpenSearch domain endpoint (REQUIRED). From the AWS console, or:
#   aws opensearch describe-domain --domain-name ttc-os-domain \
#     --region us-east-2 --query 'DomainStatus.Endpoint' --output text
OPENSEARCH_ENDPOINT_URL=https://search-ttc-os-domain-xxxxxxxx.us-east-2.es.amazonaws.com

# OpenSearch index (optional; default ttc-index)
OPENSEARCH_INDEX=ttc-index

# AWS region (optional; default us-east-2)
AWS_REGION=us-east-2

# AWS credentials permitted on the OpenSearch domain. Use ONE of:
#   - a named profile / SSO:
# AWS_PROFILE=your-profile
#   - or explicit keys:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# Hugging Face token, only if the retriever/reranker models aren't already cached
# locally and you need to download the private NCHS models.
# HF_TOKEN=hf_...

# Ports (optional). NOTE: index.html targets the backend at 127.0.0.1:8080, so if
# you change BACKEND_PORT you must also update API_BASE in index.html.
# BACKEND_PORT=8080
# FRONTEND_PORT=8000

# Restrict CORS to the demo origin (optional; default "*").
# CORS_ALLOW_ORIGINS=http://127.0.0.1:8000
